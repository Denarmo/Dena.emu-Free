pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- dena.emu test cart (our own, gpl-3.0-or-later).
-- draws every primitive the golden test checks; o (button 4)
-- turns the background dark blue. spec: docs/specs/pico8.md
f=0
function _update()
 f+=1
end
function _draw()
 cls(btn(4) and 1 or 0)
 rect(2,2,125,125,7)
 rectfill(8,8,40,30,8)
 circ(64,20,10,11)
 circfill(100,20,8,12)
 oval(8,40,56,64,9)
 ovalfill(70,40,120,60,10)
 line(8,72,120,100,14)
 pset(64,110,7)
 spr(1,56,80)
 print("dena "..f,8,112,7)
 if f>=30 then rectfill(110,110,120,120,3) end
end
