execute_process(COMMAND ${PY} ${GEN} ${OUT} RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "ROM generator failed")
endif()
file(SHA256 ${ROM} committed)
file(SHA256 ${OUT} generated)
if(NOT committed STREQUAL generated)
  message(FATAL_ERROR "${ROM} is stale: run python ${GEN} ${ROM}")
endif()
