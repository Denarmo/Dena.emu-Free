# Writes OUT: the device profiles (PROFILES_DIR/*.conf) as C string literals.
file(GLOB _confs "${PROFILES_DIR}/*.conf")
list(SORT _confs)
set(_body "// Generated from shells/linux/profiles/*.conf; do not edit.\n")
string(APPEND _body "static const char *const dena_profile_texts[] = {\n")
foreach(_f ${_confs})
  file(READ "${_f}" _t)
  string(REPLACE "\\" "\\\\" _t "${_t}")
  string(REPLACE "\"" "\\\"" _t "${_t}")
  string(REPLACE "\r" "" _t "${_t}")
  string(REPLACE "\n" "\\n\"\n  \"" _t "${_t}")
  string(APPEND _body "  \"${_t}\",\n")
endforeach()
string(APPEND _body "};\n")
file(WRITE "${OUT}.tmp" "${_body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
