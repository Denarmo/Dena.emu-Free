# SPDX-License-Identifier: GPL-3.0-or-later
# Dena.emu kernel config fragment for the Allwinner H700 handhelds, merged on
# top of arm64 defconfig by os/image/build.sh (spec: docs/specs/single-card.md).
# There are no loadable modules on the card: everything the handheld needs is
# built in, so the initramfs and the system image stay simple.

# Only the SoC we boot (plus QEMU's virt machine for the boot smoke test).
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
CONFIG_ARCH_SUNXI=y
CONFIG_LOCALVERSION="-dena"
CONFIG_MODULES=n

# Boot: initramfs finds DENA-BOOT, loop-mounts the system squashfs, overlays tmpfs.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_MMC_SUNXI=y
CONFIG_MSDOS_PARTITION=y

# Firmware built into the kernel, because the drivers ask for it at probe,
# before the root file system exists: the panel init sequences (panel-mipi),
# the RTL8821CS Wi-Fi firmware (linux/firmware.txt) and the wireless
# regulatory database with its signature (wireless-regdb from the base
# packages). The build script puts them all in EXTRA_FIRMWARE_DIR.
CONFIG_EXTRA_FIRMWARE="panels/anbernic,rg35xx-plus-panel.panel panels/anbernic,rg35xx-sp-v2-panel.panel rtw88/rtw8821c_fw.bin regulatory.db regulatory.db.p7s"
CONFIG_EXTRA_FIRMWARE_DIR="@PANEL_FIRMWARE_DIR@"

# Display: DE33 mixer, TCON TOP / TCON LCD, RGB panel over a GPIO SPI bus.
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_SUN8I_DE2_CCU=y
CONFIG_DRM_PANEL_MIPI=y
CONFIG_SPI=y
CONFIG_SPI_GPIO=y
CONFIG_PWM=y
CONFIG_PWM_SUN8I=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM_FBDEV_EMULATION=y
# No Tux per CPU at boot: the panel shows only the Dena splash (dena-splash).
# CONFIG_LOGO is not set

# GPU: Mali-G31 through Panfrost (Mesa on the system image).
CONFIG_DRM_PANFROST=y
CONFIG_SUN50I_H6_PRCM_PPU=y

# Audio: the SoC's analog codec.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN4I_CODEC=y
# The codec must be ALSA card 0 (the default device): no loopback card.
# CONFIG_SND_ALOOP is not set

# Power: AXP717 PMIC, battery, charger, power key, ADCs.
CONFIG_MFD_AXP20X_I2C=y
CONFIG_MFD_AXP20X_RSB=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_BATTERY_AXP20X=y
CONFIG_CHARGER_AXP20X=y
CONFIG_AXP20X_POWER=y
CONFIG_AXP20X_ADC=y
CONFIG_INPUT_AXP20X_PEK=y
CONFIG_SUN20I_GPADC=y
CONFIG_SUN8I_THERMAL=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=y
CONFIG_NVMEM_SUNXI_SID=y

# Input: face buttons and D-pad are gpio-keys; sticks (RG40XX) are adc-joystick.
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=y

# Wi-Fi: RTL8821CS on SDIO (mmc1), powered by mmc-pwrseq-simple.
# RESET_GPIO stays off: with it the pwrseq asks the reset framework for its
# reset-gpios, which only handles 2-cell GPIO specifiers, and the sunxi pin
# controller uses 3 cells, so the probe fails ("reset control not ready").
# Without it pwrseq-simple drives the GPIO itself.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RTW88=y
CONFIG_RTW88_8821CS=y
# CONFIG_RESET_GPIO is not set

# Board bits: LEDs, RTC on the SP/Plus, USB OTG.
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_PWM=y
CONFIG_RTC_DRV_PCF8563=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
# USB storage mode (dena-usb-storage) builds its gadget in configfs. The
# legacy g_mass_storage gadget is off: built in, it claims the port at boot
# with no backing file and fails, and it would keep configfs off the port.
CONFIG_CONFIGFS_FS=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# CONFIG_USB_MASS_STORAGE is not set

# QEMU virt (boot smoke test, os/image/qemu-test.sh): already in defconfig as
# built-ins (PL011, PCI generic host, virtio-blk); listed so a defconfig change
# can't silently break the test.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
