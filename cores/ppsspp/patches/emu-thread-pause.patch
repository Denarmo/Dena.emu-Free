+bool GLRenderManager::ThreadFrameFor(int timeoutMs) {
+	if (!runCompileThread_) {
+		return false;
+	}
+	while (true) {
+		GLRRenderThreadTask *task = nullptr;
+		{
+			std::unique_lock<std::mutex> lock(pushMutex_);
+			if (renderThreadQueue_.empty() &&
+				!pushCondVar_.wait_for(lock, std::chrono::milliseconds(timeoutMs), [this] { return !renderThreadQueue_.empty(); })) {
+				return false;
+			}
+			task = std::move(renderThreadQueue_.front());
+			renderThreadQueue_.pop();
+		}
+		if (task->runType == GLRRunType::EXIT) {
+			delete task;
+			std::unique_lock<std::mutex> lock(syncMutex_);
+			syncCondVar_.notify_one();
+			syncDone_ = true;
+			return true;
+		}
+		bool swapped = Run(*task);
+		delete task;
+		if (swapped) {
+			return true;
+		}
+	}
+}
