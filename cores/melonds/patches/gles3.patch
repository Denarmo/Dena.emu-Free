diff --git a/src/OpenGLSupport.cpp b/src/OpenGLSupport.cpp
index 9df814b..09dfea6 100644
--- a/src/OpenGLSupport.cpp
+++ b/src/OpenGLSupport.cpp
@@ -16,17 +16,72 @@
     with melonDS. If not, see http://www.gnu.org/licenses/.
 */
 
+#include <string>
+
 #include "OpenGLSupport.h"
 
 
 namespace OpenGL
 {
 
+#ifdef HAVE_OPENGLES
+// The shaders are GLSL 1.40. GLSL ES 3.00 differs only in the header
+// (version, default precision) and in fragment outputs, which need explicit
+// locations because GLES has no glBindFragDataLocation.
+static std::string ToGLES(const char* src, bool frag)
+{
+    std::string s(src);
+    const std::string v140 = "#version 140";
+    size_t pos = s.find(v140);
+    if (pos != std::string::npos)
+        s.replace(pos, v140.size(),
+            "#version 300 es\n"
+            "precision highp float;\n"
+            "precision highp int;\n"
+            "precision highp sampler2D;\n"
+            "precision highp usampler2D;\n");
+    if (frag)
+    {
+        const char* outs[][2] = {
+            {"\nout vec4 oColor;", "\nlayout(location = 0) out vec4 oColor;"},
+            {"\nout vec4 oAttr;", "\nlayout(location = 1) out vec4 oAttr;"},
+        };
+        for (auto& o : outs)
+            if ((pos = s.find(o[0])) != std::string::npos)
+                s.replace(pos, strlen(o[0]), o[1]);
+    }
+    return s;
+}
+
+#endif
+
+bool SupportsRenderer()
+{
+#ifdef HAVE_OPENGLES
+    // The 3D renderer needs GLES 3.2: indexed colour masks (glColorMaski)
+    // and glFramebufferTexture. Older devices keep the software renderer.
+    const char* ver = (const char*)glGetString(GL_VERSION);
+    int major = 0, minor = 0;
+    if (!ver || sscanf(ver, "OpenGL ES %d.%d", &major, &minor) != 2) return false;
+    if (major > 3 || (major == 3 && minor >= 2)) return true;
+    printf("OpenGL: %s, the 3D renderer needs OpenGL ES 3.2\n", ver);
+    return false;
+#else
+    return true;
+#endif
+}
+
 bool BuildShaderProgram(const char* vs, const char* fs, GLuint* ids, const char* name)
 {
     int len;
     int res;
 
+#ifdef HAVE_OPENGLES
+    std::string vs_es = ToGLES(vs, false), fs_es = ToGLES(fs, true);
+    vs = vs_es.c_str();
+    fs = fs_es.c_str();
+#endif
+
     ids[0] = glCreateShader(GL_VERTEX_SHADER);
     len = strlen(vs);
     glShaderSource(ids[0], 1, &vs, &len);
@@ -65,8 +120,11 @@ bool BuildShaderProgram(const char* vs, const char* fs, GLuint* ids, const char*
         delete[] log;
 
         FILE* logf = fopen("shaderfail.log", "w");
-        fwrite(fs, len+1, 1, logf);
-        fclose(logf);
+        if (logf)
+        {
+            fwrite(fs, len+1, 1, logf);
+            fclose(logf);
+        }
 
         glDeleteShader(ids[0]);
         glDeleteShader(ids[1]);
